    <!-- 3. EVENT-WISE LIVE TRACKER TABLE (12 EVENTS) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h3 class="text-sm font-bold text-slate-900">Event-wise Live Tracker (12 Events)</h3>
          <p class="text-xs text-slate-500">Live breakdown of registrations, token issuance, check-in, and stage status</p>
        </div>
        <a href="/reports" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-3 py-1.5 rounded-lg border border-slate-200 flex items-center gap-1.5 self-start sm:self-auto">
          <i class="fa-solid fa-download"></i> Export Event Stats
        </a>
      </div>
      
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-700">
          <thead class="bg-slate-50 text-[11px] uppercase tracking-wider text-slate-400 font-bold border-b border-slate-200">
            <tr>
              <th class="px-4 py-3">Event Code &amp; Name</th>
              <th class="px-3 py-3">Prefix</th>
              <th class="px-3 py-3 text-center">Total</th>
              <th class="px-3 py-3 text-center">Junior</th>
              <th class="px-3 py-3 text-center">Senior</th>
              <th class="px-3 py-3 text-center">Tokens</th>
              <th class="px-3 py-3 text-center">Present</th>
              <th class="px-3 py-3 text-center">Done</th>
              <th class="px-4 py-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-medium">
            <% eventStats.forEach(ev => { %>
              <tr class="hover:bg-slate-50 transition">
                <td class="px-4 py-3">
                  <div class="font-extrabold text-slate-900"><%= ev.name %></div>
                  <span class="text-[10px] text-slate-400 font-mono"><%= ev.eventCode %></span>
                </td>
                <td class="px-3 py-3 font-mono font-bold text-blue-600"><%= ev.prefix %></td>
                <td class="px-3 py-3 text-center font-bold text-slate-900"><%= ev.total %></td>
                <td class="px-3 py-3 text-center text-slate-600"><%= ev.junior %></td>
                <td class="px-3 py-3 text-center text-slate-600"><%= ev.senior %></td>
                <td class="px-3 py-3 text-center font-mono font-bold text-indigo-600"><%= ev.tokens %></td>
                <td class="px-3 py-3 text-center font-bold text-emerald-600"><%= ev.present %></td>
                <td class="px-3 py-3 text-center font-bold text-purple-600"><%= ev.done %></td>
                <td class="px-4 py-3 text-right">
                  <a href="/coordinator?eventId=<%= ev.eventId %>" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-lg font-bold text-[11px] inline-flex items-center gap-1 transition">
                    Open Stage →
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </main>

</body>
</html>
