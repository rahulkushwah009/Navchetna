<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Admin Overview | Navchetna: Yuva Shakti Mahotsav 2026</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- Inter Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              800: '#1e3a8a',
              900: '#0f172a',
            }
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .tap-active:active { transform: scale(0.98); }
  </style>
</head>

<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col antialiased">

  <!-- ================= TOP HEADER ================= -->
  <header class="sticky top-0 z-40 bg-slate-900 border-b border-slate-800 text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 py-2.5 flex items-center justify-between">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-orange-500 to-amber-400 flex items-center justify-center shadow-lg shadow-orange-500/20 text-slate-950 font-black">
          <i class="fa-solid fa-fire text-lg"></i>
        </div>
        <div>
          <div class="text-[10px] tracking-widest uppercase font-bold text-orange-400">Gurukul Dream Foundation</div>
          <h1 class="text-sm sm:text-base font-extrabold tracking-tight text-white flex items-center gap-1.5">
            Navchetna 2026
            <span class="hidden sm:inline-block text-[11px] font-normal text-slate-400">| Yuva Shakti Mahotsav</span>
          </h1>
        </div>
      </div>

      <!-- Quick Role Info / Logout -->
      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-2 bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700 text-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="font-bold text-slate-200">Super Admin</span>
          <span class="text-slate-500 font-mono text-[10px]">(<%= staff.email %>)</span>
        </div>
        <a href="/manage-staff" class="bg-slate-800 hover:bg-slate-700 text-xs font-semibold px-3 py-1.5 rounded-lg border border-slate-700 text-slate-300">
          <i class="fa-solid fa-user-gear"></i> <span class="hidden md:inline">Staff</span>
        </a>
        <a href="/logout" class="bg-rose-950/60 hover:bg-rose-900 border border-rose-800 text-rose-300 text-xs font-semibold px-3 py-1.5 rounded-lg transition">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </a>
      </div>
    </div>

    <!-- ================= NAVBAR ================= -->
 <nav class="bg-slate-950 border-t border-slate-800/80 px-4 overflow-x-auto">
      <div class="max-w-7xl mx-auto flex items-center space-x-1 text-xs font-semibold whitespace-nowrap">
        <a href="/dashboard" class="px-4 py-3 border-b-2 border-blue-500 text-blue-400 flex items-center gap-2">
          <i class="fa-solid fa-chart-pie"></i> Admin Overview
        </a>
        <a href="/desk" class="px-4 py-3 border-b-2 border-transparent text-slate-400 hover:text-white flex items-center gap-2">
          <i class="fa-solid fa-id-card"></i> Event Day Desk
        </a>
        <a href="/distribution" class="px-4 py-3 border-b-2 border-transparent text-slate-400 hover:text-white flex items-center gap-2">
          <i class="fa-solid fa-network-wired"></i> Contact Distribution
        </a>
        <a href="/corrections" class="px-4 py-3 border-b-2 border-transparent text-slate-400 hover:text-white flex items-center gap-2">
  <i class="fa-solid fa-clipboard-check"></i> Master Desk
  <% if (typeof kpis !== 'undefined' && kpis && kpis.pendingCorrections) { %>
    <span class="bg-amber-500 text-slate-900 px-1.5 py-0.2 rounded-full text-[10px] font-bold"><%= kpis.pendingCorrections %></span>
  <% } %>
</a>
      </div>
    </nav>
  </header>

  <!-- ================= MAIN CONTENT ================= -->
  <main class="flex-1 max-w-7xl mx-auto w-full p-3 sm:p-5 space-y-5">

    <!-- 1. TOP 6 OPERATIONAL KPI CARDS -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      
      <!-- Total Registrations -->
      <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <span class="text-[11px] font-semibold text-slate-500 uppercase">Total Registrations</span>
        <div class="mt-2 flex items-baseline justify-between">
          <span class="text-2xl font-extrabold text-slate-900"><%= kpis.totalReg %></span>
          <i class="fa-solid fa-users text-blue-600/30 text-lg"></i>
        </div>
        <span class="text-[10px] text-emerald-600 font-semibold mt-1">100% Verified DB</span>
      </div>

      <!-- Present Today -->
      <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <span class="text-[11px] font-semibold text-slate-500 uppercase">Present Today</span>
        <div class="mt-2 flex items-baseline justify-between">
          <span class="text-2xl font-extrabold text-emerald-600"><%= kpis.presentCount %></span>
          <i class="fa-solid fa-user-check text-emerald-600/30 text-lg"></i>
        </div>
        <span class="text-[10px] text-slate-500 font-medium mt-1"><%= kpis.presentPct %>% Checked In</span>
      </div>

      <!-- Tokens Issued -->
      <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <span class="text-[11px] font-semibold text-slate-500 uppercase">Tokens Issued</span>
        <div class="mt-2 flex items-baseline justify-between">
          <span class="text-2xl font-extrabold text-indigo-600"><%= kpis.tokensIssued %></span>
          <i class="fa-solid fa-ticket text-indigo-600/30 text-lg"></i>
        </div>
        <span class="text-[10px] text-indigo-500 font-medium mt-1">Pre-printed sequence</span>
      </div>

      <!-- Performances Done -->
      <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <span class="text-[11px] font-semibold text-slate-500 uppercase">Performances Done</span>
        <div class="mt-2 flex items-baseline justify-between">
          <span class="text-2xl font-extrabold text-purple-600"><%= kpis.performancesDone %></span>
          <i class="fa-solid fa-award text-purple-600/30 text-lg"></i>
        </div>
        <span class="text-[10px] text-purple-500 font-medium mt-1">Live Coordinator feed</span>
      </div>

      <!-- Calls Made -->
      <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <span class="text-[11px] font-semibold text-slate-500 uppercase">Calls Made</span>
        <div class="mt-2 flex items-baseline justify-between">
          <span class="text-2xl font-extrabold text-blue-600"><%= kpis.callsMade %></span>
          <i class="fa-solid fa-phone-volume text-blue-600/30 text-lg"></i>
        </div>
        <span class="text-[10px] text-blue-500 font-medium mt-1">CRM Follow-ups</span>
      </div>

      <!-- WhatsApp Sent -->
      <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <span class="text-[11px] font-semibold text-slate-500 uppercase">WhatsApp Sent</span>
        <div class="mt-2 flex items-baseline justify-between">
          <span class="text-2xl font-extrabold text-green-600"><%= kpis.whatsappSent %></span>
          <i class="fa-brands fa-whatsapp text-green-600/30 text-lg"></i>
        </div>
        <span class="text-[10px] text-emerald-500 font-medium mt-1">Confirmed delivery</span>
      </div>
    </div>

    <!-- 2. SPEED DESK, FOLLOW-UP HEALTH & PARTICIPANT STATS -->
    <!-- <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      
      <!- Event Day Speed Access Card -->
