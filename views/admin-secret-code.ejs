<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Secret Codes — NYSM 2026</title>
  <style>
    :root {
      --ink: #1B1030;
      --marigold: #FFA630;
      --gulal: #E63E7C;
      --cream: #FFF8ED;
      --radius: 12px;
    }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--ink);
      color: var(--cream);
      margin: 0;
      padding: 40px 20px;
    }
    .container {
      max-width: 650px;
      margin: 0 auto;
    }
    h1 {
      color: var(--marigold);
      margin-bottom: 24px;
    }
    .card {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius);
      padding: 24px;
      margin-bottom: 30px;
    }
    .form-group {
      margin-bottom: 16px;
    }
    label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
      color: var(--marigold);
    }
    input {
      width: 100%;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
      box-sizing: border-box;
      font-size: 15px;
    }
    input:focus {
      outline: none;
      border-color: var(--gulal);
    }
    button {
      background: linear-gradient(120deg, var(--marigold), var(--gulal));
      color: #fff;
      border: none;
      padding: 12px 20px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      width: 100%;
      font-size: 15px;
    }
    .alert {
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 16px;
      font-weight: 600;
    }
    .alert.success { background: #2E9E6B; color: #fff; }
    .alert.error { background: #E5484D; color: #fff; }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }
    th, td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    th { color: var(--marigold); font-size: 13px; }
    .badge {
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: bold;
    }
    .badge.active { background: #2E9E6B; color: #fff; }
    .badge.inactive { background: #E5484D; color: #fff; }
  </style>
</head>
<body>
  <div class="container">
    <h1>🔑 Secret Code Management</h1>

    <% if (message) { %>
      <div class="alert <%= message.type %>"><%= message.text %></div>
    <% } %>

    <!-- Add Code Form -->
    <div class="card">
      <h3 style="margin-top: 0;">Add New Secret Code</h3>
      <form action="/admin/secret-codes" method="POST">
        <div class="form-group">
          <label for="code">Secret Code (e.g. SPONSOR2026)</label>
          <input type="text" id="code" name="code" required placeholder="ENTER CODE" style="text-transform: uppercase;">
        </div>
        <div class="form-group">
          <label for="label">Description / Tag</label>
          <input type="text" id="label" name="label" placeholder="e.g. VIP Guest / Sponsor Pass">
        </div>
        <button type="submit">Add Secret Code</button>
      </form>
    </div>

    <!-- Active Secret Codes List -->
    <div class="card">
      <h3 style="margin-top: 0;">Existing Secret Codes</h3>
      <% if (codes.length === 0) { %>
        <p style="color: rgba(255,255,255,0.6);">No secret codes found in the database.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>CODE</th>
              <th>LABEL</th>
              <th>STATUS</th>
            </tr>
          </thead>
          <tbody>
            <% codes.forEach(c => { %>
              <tr>
                <td style="font-weight: bold; letter-spacing: 0.05em;"><%= c.code %></td>
                <td><%= c.label %></td>
                <td>
                  <span class="badge <%= c.isActive ? 'active' : 'inactive' %>">
                    <%= c.isActive ? 'ACTIVE' : 'INACTIVE' %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</body>
</html>