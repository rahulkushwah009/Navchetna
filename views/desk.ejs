<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Event Day Entry Desk | Navchetna 2026</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    body { font-family: 'Inter', sans-serif; -webkit-tap-highlight-color: transparent; }
    .tap-active:active { transform: scale(0.97); }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn { animation: fadeIn 0.15s ease-out forwards; }
  </style>
</head>

<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col antialiased">

  <!-- ================= COMPACT HEADER ================= -->
  <header class="sticky top-0 z-40 bg-slate-900 border-b border-slate-800 text-white shadow">
    <div class="px-3.5 py-2.5 flex items-center justify-between max-w-lg mx-auto w-full">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-orange-500 to-amber-400 flex items-center justify-center text-slate-950 font-black text-sm shadow">
          <i class="fa-solid fa-fire"></i>
        </div>
        <div>
          <h1 class="text-sm font-bold tracking-tight text-white leading-tight">Navchetna 2026</h1>
          <span class="text-[10px] text-emerald-400 font-semibold block leading-none">Entry Desk</span>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-[11px] bg-slate-800 border border-slate-700 text-slate-300 px-2 py-1 rounded font-medium max-w-[130px] truncate">
          <%= staff.email.split('@')[0] %>
        </span>
        <a href="/logout" class="bg-rose-950/70 border border-rose-800 text-rose-300 w-8 h-8 rounded-lg flex items-center justify-center text-xs active:bg-rose-900 transition" title="Logout">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </a>
      </div>
    </div>

    <!-- Quick Navigation Tabs (Touch Scrollable) -->
    <nav class="flex border-t border-slate-800/80 px-2 overflow-x-auto text-xs font-semibold whitespace-nowrap bg-slate-950 no-scrollbar">
      <a href="/desk" class="px-3.5 py-2 border-b-2 border-emerald-400 text-emerald-400 flex items-center gap-1.5">
        <i class="fa-solid fa-id-card"></i> Desk
      </a>
      <a href="/dashboard" class="px-3.5 py-2 text-slate-400 hover:text-white flex items-center gap-1.5">
        <i class="fa-solid fa-chart-pie"></i> Overview
      </a>
      <a href="/distribution" class="px-3.5 py-2 text-slate-400 hover:text-white flex items-center gap-1.5">
        <i class="fa-solid fa-network-wired"></i> Contacts
      </a>
      <a href="/corrections" class="px-3.5 py-2 text-slate-400 hover:text-white flex items-center gap-1.5">
        <i class="fa-solid fa-clipboard-check"></i> Master
      </a>
    </nav>
  </header>

  <!-- ================= MAIN CONTAINER ================= -->
  <main class="flex-1 max-w-lg mx-auto w-full p-3 space-y-3">

    <!-- SEARCH BAR -->
    <div class="bg-white rounded-xl p-3 shadow-sm border border-slate-200 space-y-2">
      <div class="relative flex items-center">
        <i class="fa-solid fa-magnifying-glass absolute left-3 text-slate-400 text-sm"></i>
        <input 
          type="text" 
          id="deskSearchInput" 
          onkeydown="if(event.key === 'Enter') triggerSearch()"
          placeholder="Phone, Slot, or Ticket ID..." 
          class="w-full bg-slate-50 text-slate-900 text-base font-semibold pl-9 pr-8 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition placeholder-slate-400"
          autocomplete="off"
          autocapitalize="off"
        >
        <button 
          id="clearDeskSearchBtn" 
          onclick="clearDeskSearch()" 
          class="hidden absolute right-2.5 text-slate-400 hover:text-slate-600 p-1"
        >
          <i class="fa-solid fa-circle-xmark text-base"></i>
        </button>
      </div>

      <div class="flex gap-2">
        <button 
          onclick="triggerSearch()" 
          class="flex-1 bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white py-2.5 rounded-lg text-sm font-bold flex items-center justify-center gap-1.5 shadow-sm tap-active transition"
        >
          <i class="fa-solid fa-bolt"></i> Find Participant
        </button>
        <button 
          onclick="toggleFilterBar()" 
          class="bg-slate-100 border border-slate-200 text-slate-600 px-3 py-2.5 rounded-lg text-xs font-semibold tap-active"
        >
          <i class="fa-solid fa-sliders"></i>
        </button>
      </div>

      <!-- Collapsible Filters -->
      <div id="filterBarContainer" class="hidden pt-2 border-t border-slate-100 grid grid-cols-2 gap-2 text-xs">
        <div>
          <label class="block text-[10px] font-bold text-slate-400 uppercase mb-0.5">Event</label>
          <select id="filterEventId" class="w-full bg-slate-50 border border-slate-200 text-slate-700 py-1.5 px-2 rounded-lg focus:outline-none">
            <option value="">All Events</option>
            <option value="esports">E-Sports</option>
            <option value="rangotsav">Rangotsav</option>
            <option value="bharatbodh">Bharat Bodh</option>
            <option value="techmanthan">Tech Manthan</option>
            <option value="yuvavani">Yuva-Vani</option>
            <option value="loknritya">Loknritya</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-slate-400 uppercase mb-0.5">Status</label>
          <select id="filterStatus" class="w-full bg-slate-50 border border-slate-200 text-slate-700 py-1.5 px-2 rounded-lg focus:outline-none">
            <option value="">All Statuses</option>
            <option value="PAID">PAID</option>
            <option value="COMPLIMENTARY">COMPLIMENTARY</option>
            <option value="PENDING">PENDING</option>
          </select>
        </div>
      </div>
    </div>

    <!-- EMPTY PROMPT -->
    <div id="deskEmptyState" class="bg-white rounded-xl py-10 px-4 text-center border border-slate-200 shadow-sm">
      <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 mx-auto flex items-center justify-center text-xl mb-2">
        <i class="fa-solid fa-qrcode"></i>
      </div>
      <h3 class="text-sm font-bold text-slate-700">Ready for Scan / Entry</h3>
      <p class="text-xs text-slate-400 mt-0.5">Type phone number or ticket ID to begin check-in.</p>
    </div>

    <!-- MULTI-MATCH PICKER -->
    <div id="multiParticipantStrip" class="hidden bg-white rounded-xl p-3 border border-blue-200 shadow-sm space-y-2">
      <div class="flex items-center justify-between text-xs">
        <span class="font-extrabold text-slate-800">Multiple Entries Found</span>
        <span class="bg-blue-100 text-blue-800 font-bold px-2 py-0.5 rounded-full text-[10px]" id="multiCountBadge">0</span>
      </div>
      <div id="multiParticipantList" class="space-y-1.5 max-h-48 overflow-y-auto">
        <!-- Rendered items -->
      </div>
    </div>

    <!-- ACTIVE PARTICIPANT CARD -->
    <div id="deskActiveCard" class="hidden bg-white rounded-xl border border-slate-200 shadow-md overflow-hidden animate-fadeIn space-y-3 p-3">
      
      <!-- Top Overview Bar -->
      <div class="flex items-start justify-between gap-2 border-b border-slate-100 pb-2.5">
        <div>
          <div class="flex items-center gap-1.5 flex-wrap">
            <h3 id="cardParticipantName" class="text-base font-black text-slate-900 leading-snug">Participant Name</h3>
            <span id="cardPayment" class="text-[10px] font-extrabold px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800">PAID</span>
          </div>
          <div class="text-xs text-slate-500 font-mono mt-0.5 flex items-center gap-2 flex-wrap">
            <span>📱 <span id="cardMobile"></span></span>
            <span>•</span>
            <span>Slot: <strong id="cardSlot" class="text-slate-800"></strong></span>
          </div>
          <div class="text-[11px] text-slate-400 font-mono truncate" id="cardTicket"></div>
        </div>

        <button 
          id="markAllPresentBtn"
          onclick="markAllEventsPresent()" 
          class="bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-extrabold text-xs px-3 py-2 rounded-lg shrink-0 flex items-center gap-1 tap-active shadow"
        >
          <i class="fa-solid fa-check-double"></i> Check-in All
        </button>
      </div>

      <!-- Quick Inline Name Correction -->
      <div class="bg-amber-50 rounded-lg p-2 border border-amber-200 flex items-center gap-1.5">
        <input 
          type="text" 
          id="correctedNameInput" 
          placeholder="Correct name if wrong..." 
          class="flex-1 bg-white border border-amber-300 text-slate-900 px-2 py-1.5 rounded text-xs focus:outline-none"
        >
        <button 
          onclick="saveCorrectedNameOnly()"
          class="bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold px-2.5 py-1.5 rounded shrink-0 tap-active"
        >
          Save
        </button>
      </div>

      <!-- Compact Details -->
      <div class="grid grid-cols-2 gap-2 text-xs bg-slate-50 p-2 rounded-lg border border-slate-100">
        <div>
          <span class="text-[10px] uppercase font-bold text-slate-400 block">Institution</span>
          <span id="cardSchool" class="font-medium text-slate-700 truncate block">Not Specified</span>
        </div>
        <div>
          <span class="text-[10px] uppercase font-bold text-slate-400 block">Course / Class</span>
          <span id="cardClass" class="font-medium text-slate-700 truncate block">N/A</span>
        </div>
      </div>

      <!-- Events List -->
      <div class="space-y-1.5 pt-1">
        <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wide">Enrolled Events</div>
        <div id="enrolledEventsContainer" class="space-y-2">
          <!-- Dynamically populated -->
        </div>
      </div>

    </div>

    <!-- SUCCESS SCREEN -->
    <div id="deskSuccessState" class="hidden bg-emerald-50 border border-emerald-300 rounded-xl p-5 text-center animate-fadeIn">
      <div class="w-12 h-12 bg-emerald-500 text-white rounded-full flex items-center justify-center mx-auto text-xl shadow mb-2">
        <i class="fa-solid fa-check"></i>
      </div>
      <div class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider">Checked In Successfully</div>
      <h3 id="successName" class="text-base font-extrabold text-slate-900 mt-0.5">Participant</h3>
      
      <div id="successTokensList" class="mt-3 flex flex-wrap items-center justify-center gap-1.5">
        <!-- Tokens rendered here -->
      </div>
      
      <button 
        onclick="resetDeskForNext()" 
        class="mt-4 w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 rounded-lg text-xs tap-active transition"
      >
        Next Participant →
      </button>
    </div>

  </main>

  <!-- ================= SCRIPTS ================= -->
  <script>
    let searchResultsList = [];
    let currentParticipant = null;
    let currentEvents = [];

    function toggleFilterBar() {
      document.getElementById("filterBarContainer").classList.toggle("hidden");
    }

    function clearDeskSearch() {
      const input = document.getElementById("deskSearchInput");
      input.value = "";
      document.getElementById("clearDeskSearchBtn").classList.add("hidden");
      resetToEmptyState();
      input.focus();
    }

    function resetToEmptyState() {
      document.getElementById("deskActiveCard").classList.add("hidden");
      document.getElementById("deskSuccessState").classList.add("hidden");
      document.getElementById("multiParticipantStrip").classList.add("hidden");
      document.getElementById("deskEmptyState").classList.remove("hidden");
      searchResultsList = [];
      currentParticipant = null;
      currentEvents = [];
    }

    function resetDeskForNext() {
      clearDeskSearch();
    }

    async function triggerSearch() {
      const query = document.getElementById("deskSearchInput").value.trim();
      const clearBtn = document.getElementById("clearDeskSearchBtn");

      if (!query) {
        clearBtn.classList.add("hidden");
        resetToEmptyState();
        return;
      }
      clearBtn.classList.remove("hidden");

      const eventFilter = document.getElementById("filterEventId")?.value || "";
      const statusFilter = document.getElementById("filterStatus")?.value || "";

      const params = new URLSearchParams({ q: query, eventId: eventFilter, status: statusFilter });

      try {
        const res = await fetch(`/api/desk/search?${params.toString()}`);
        const data = await res.json();

        if (!data.success || (!data.participant && (!data.participants || data.participants.length === 0))) {
          alert("No participant found for: " + query);
          resetToEmptyState();
          return;
        }

        const list = Array.isArray(data.participants) && data.participants.length > 0 
          ? data.participants 
          : (data.participant ? [{ participant: data.participant, events: data.events || [] }] : []);

        searchResultsList = list;

        if (list.length === 1) {
          document.getElementById("multiParticipantStrip").classList.add("hidden");
          renderParticipantCard(list[0].participant, list[0].events || []);
        } else {
          renderMultiParticipantSelector(list);
          renderParticipantCard(list[0].participant, list[0].events || []);
        }
      } catch (err) {
        console.error("Search error:", err);
        alert("Search request failed.");
      }
    }

    function renderMultiParticipantSelector(list) {
      const strip = document.getElementById("multiParticipantStrip");
      const listContainer = document.getElementById("multiParticipantList");
      const badge = document.getElementById("multiCountBadge");

      strip.classList.remove("hidden");
      badge.textContent = `${list.length} Records`;
      listContainer.innerHTML = "";

      list.forEach((item, index) => {
        const p = item.participant;
        const displayName = p.correctedName || p.fullName;
        const card = document.createElement("div");
        card.className = "p-2 rounded-lg border border-slate-200 bg-slate-50 hover:bg-blue-50 active:bg-blue-100 cursor-pointer flex items-center justify-between text-xs tap-active";
        card.onclick = () => selectParticipantFromMulti(index);

        card.innerHTML = `
          <div>
            <div class="font-bold text-slate-900">${displayName}</div>
            <div class="text-[10px] text-slate-500 font-mono">Slot: ${p.teamSlot} | ID: ${p.ticketId}</div>
          </div>
          <span class="text-[10px] font-bold px-1.5 py-0.5 rounded ${p.status === 'PAID' ? 'bg-emerald-100 text-emerald-800' : 'bg-blue-100 text-blue-800'}">
            ${p.status}
          </span>
        `;
        listContainer.appendChild(card);
      });
    }

    function selectParticipantFromMulti(index) {
      const item = searchResultsList[index];
      if (item) renderParticipantCard(item.participant, item.events || []);
    }

    function renderParticipantCard(participant, events) {
      currentParticipant = participant;
      currentEvents = events;

      document.getElementById("deskEmptyState").classList.add("hidden");
      document.getElementById("deskSuccessState").classList.add("hidden");
      document.getElementById("deskActiveCard").classList.remove("hidden");

      const activeName = (participant.correctedName && participant.correctedName.trim() !== "") 
        ? participant.correctedName 
        : participant.fullName;

      document.getElementById("cardParticipantName").textContent = activeName;
      document.getElementById("correctedNameInput").value = participant.correctedName || "";
      document.getElementById("cardMobile").textContent = participant.mobile;
      document.getElementById("cardSlot").textContent = participant.teamSlot;
      document.getElementById("cardTicket").textContent = participant.ticketId;
      document.getElementById("cardSchool").textContent = participant.school || "Not Specified";
      document.getElementById("cardClass").textContent = participant.classCourse || "N/A";
      document.getElementById("cardPayment").textContent = `${participant.status}`;

      const eventsContainer = document.getElementById("enrolledEventsContainer");
      eventsContainer.innerHTML = "";

      if (events.length === 0) {
        eventsContainer.innerHTML = `<div class="p-2 text-xs text-slate-400 bg-slate-50 rounded">No events registered.</div>`;
        return;
      }

      events.forEach((ev) => {
        const isPresent = ev.entryStatus === "PRESENT";
        const tokenDisplay = ev.tokenNumber && ev.tokenNumber.trim() !== "" ? ev.tokenNumber : "Not Issued";

        const item = document.createElement("div");
        item.className = "p-2.5 bg-slate-50 rounded-lg border border-slate-200 flex items-center justify-between gap-2";

        item.innerHTML = `
          <div>
            <div class="font-bold text-slate-900 text-xs">${ev.eventName}</div>
            <div class="text-[10px] text-slate-500 font-mono">
              ${isPresent ? `<span class="text-emerald-700 font-bold">TOKEN: ${tokenDisplay}</span>` : '<span class="text-amber-600">Pending</span>'}
            </div>
          </div>
          <div>
            ${isPresent ? `
              <span class="text-xs text-emerald-700 font-bold bg-emerald-100 px-2 py-1 rounded inline-flex items-center gap-1">
                <i class="fa-solid fa-check"></i> Present
              </span>
            ` : `
              <button 
                onclick="markPresent('${ev._id}', '${ev.eventName}')"
                class="bg-emerald-600 active:bg-emerald-700 text-white font-bold px-3 py-1.5 rounded text-xs tap-active transition"
              >
                Check In
              </button>
            `}
          </div>
        `;
        eventsContainer.appendChild(item);
      });
    }

    async function saveCorrectedNameOnly() {
      if (!currentParticipant?.id) return;
      const correctedName = document.getElementById("correctedNameInput").value.trim();

      try {
        const res = await fetch("/api/desk/update-name", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ 
            registrationId: currentParticipant.id, 
            ticketId: currentParticipant.ticketId, 
            correctedName 
          }),
        });

        const data = await res.json();
        if (data.success) {
          currentParticipant.correctedName = data.correctedName;
          document.getElementById("cardParticipantName").textContent = data.correctedName || currentParticipant.fullName;
          alert("Name updated.");
        } else {
          alert(data.message || "Failed to update name.");
        }
      } catch (err) {
        alert("Server error.");
      }
    }

    async function markPresent(trackingId, eventName) {
      const correctedName = document.getElementById("correctedNameInput").value.trim();

      try {
        const res = await fetch("/api/desk/mark-present", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ 
            trackingId, 
            correctedName, 
            registrationId: currentParticipant?.id,
            ticketId: currentParticipant?.ticketId 
          }),
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          alert(data.message || "Failed to mark present");
          return;
        }

        const activeName = data.correctedName || (currentParticipant ? currentParticipant.fullName : "Participant");
        showSuccessScreen([{ eventName, token: data.tokenNumber }], activeName);
      } catch (err) {
        alert("Server error.");
      }
    }

    async function markAllEventsPresent() {
      if (!currentParticipant?.id) return;
      const correctedName = document.getElementById("correctedNameInput").value.trim();

      try {
        const res = await fetch("/api/desk/mark-all-present", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ 
            registrationId: currentParticipant.id, 
            ticketId: currentParticipant.ticketId, 
            correctedName 
          }),
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          alert(data.message || "Failed to check in all events");
          return;
        }

        const activeName = data.correctedName || (currentParticipant ? currentParticipant.fullName : "Participant");
        showSuccessScreen(data.tokens || [], activeName);
      } catch (err) {
        alert("Server error.");
      }
    }

    function showSuccessScreen(tokens, activeName) {
      document.getElementById("deskActiveCard").classList.add("hidden");
      document.getElementById("deskSuccessState").classList.remove("hidden");
      document.getElementById("successName").textContent = activeName;
      
      const tokensContainer = document.getElementById("successTokensList");
      tokensContainer.innerHTML = "";

      if (tokens.length === 0) {
        tokensContainer.innerHTML = `<span class="bg-emerald-100 text-emerald-900 px-2.5 py-1 rounded text-xs font-bold">Checked In</span>`;
      } else {
        tokens.forEach(t => {
          const badge = document.createElement("div");
          badge.className = "bg-white border border-emerald-300 text-slate-800 px-2.5 py-1 rounded text-xs font-mono font-bold shadow-sm";
          badge.innerHTML = `${t.eventName}: <strong class="text-emerald-700">${t.token}</strong>`;
          tokensContainer.appendChild(badge);
        });
      }
    }
  </script>
</body>
</html>
