    <!-- JAVASCRIPT -->
    <script>
        // Mobile Toggle
        const menuToggle = document.getElementById('mobile-menu');
        const navMenu = document.querySelector('.nav-menu');

        menuToggle.addEventListener('click', () => {
            navMenu.classList.toggle('active');
            const icon = menuToggle.querySelector('i');
            icon.classList.toggle('fa-bars');
            icon.classList.toggle('fa-xmark');
        });

        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', () => {
                navMenu.classList.remove('active');
                const icon = menuToggle.querySelector('i');
                icon.classList.add('fa-bars');
                icon.classList.remove('fa-xmark');
            });
        });

        // Countdown Timer
        const launchDate = new Date("October 03, 2026 09:00:00").getTime();

        function handleClock() {
            const current = new Date().getTime();
            const gap = launchDate - current;

            if (gap < 0) {
                document.getElementById('clock-container').innerHTML = "<h3 style='color:var(--accent); font-size:1.5rem;'>Festival Is Now Live! Welcome to Navchetna!</h3>";
                return;
            }

            const secBasis = 1000;
            const minBasis = secBasis * 60;
            const hourBasis = minBasis * 60;
            const dayBasis = hourBasis * 24;

            const daysLeft = Math.floor(gap / dayBasis);
            const hoursLeft = Math.floor((gap % dayBasis) / hourBasis);
            const minsLeft = Math.floor((gap % hourBasis) / minBasis);
            const secsLeft = Math.floor((gap % minBasis) / secBasis);

            document.getElementById('days').innerText = daysLeft < 10 ? '0' + daysLeft : daysLeft;
            document.getElementById('hours').innerText = hoursLeft < 10 ? '0' + hoursLeft : hoursLeft;
            document.getElementById('mins').innerText = minsLeft < 10 ? '0' + minsLeft : minsLeft;
            document.getElementById('secs').innerText = secsLeft < 10 ? '0' + secsLeft : secsLeft;
        }
        setInterval(handleClock, 1000);
        handleClock();

        // Statistics Counter
        const statElements = document.querySelectorAll('.stat-box h2');
        const processingSpeed = 50;

        const triggerStats = () => {
            statElements.forEach(element => {
                const stepAnimation = () => {
                    const threshold = parseInt(element.getAttribute('data-target'));
                    const currentVal = parseInt(element.innerText);
                    const incrementStep = Math.ceil(threshold / processingSpeed);

                    if (currentVal < threshold) {
                        if (threshold === 5) {
                            element.innerText = currentVal + incrementStep >= threshold ? "₹5L+" : "₹" + (currentVal + incrementStep) + "L+";
                        } else if (threshold === 20) {
                            element.innerText = currentVal + incrementStep >= threshold ? "20K+" : (currentVal + incrementStep) + "K+";
                        } else {
                            element.innerText = currentVal + incrementStep >= threshold ? threshold + "+" : (currentVal + incrementStep) + "+";
                        }
                        setTimeout(stepAnimation, 30);
                    } else {
                        element.innerText = threshold === 5 ? "₹5L+" : threshold === 20 ? "20K+" : threshold + "+";
                    }
                };
                stepAnimation();
            });
        };

        const viewObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    triggerStats();
                    obs.unobserve(entry.target);
                }
            });
        }, { threshold: 0.6 });

        viewObserver.observe(document.querySelector('.stats-section'));
    </script>
