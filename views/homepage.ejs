.cta-section h2 { font-size: 3rem; font-weight: 800; margin-bottom: 10px; }
.cta-section p { font-size: 1.3rem; color: rgba(255,255,255,0.85); margin-bottom: 40px; }

/* --- FOOTER --- */
footer {
