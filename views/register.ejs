<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>Navchetna Yuva Shakti Mahotsav 2026 — Registration</title>

<style>
  :root{
    /* ---- Design tokens : "Navchetna" — night mela, marigold + gulal ---- */
    --ink:         #1B1030;
    --ink-2:       #2A1B49;
    --marigold:    #FFA630;
    --marigold-2:  #FFC15E;
    --gulal:       #E63E7C;
    --gulal-2:     #FF6FA5;
    --cream:       #FFF8ED;
    --cream-2:     #FFEFD6;
    --ok:          #2E9E6B;
    --err:         #E5484D;
    --line:        rgba(255,255,255,0.14);
    --shadow:      0 20px 50px -20px rgba(15,5,35,0.55);

    --font-display: 'Baloo 2', 'Poppins', sans-serif;
    --font-body:    'Inter', sans-serif;
    --font-deva:    'Noto Sans Devanagari', 'Inter', sans-serif;

    --radius: 18px;
    --radius-sm: 12px;
  }

  @import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@500;600;700&display=swap');

  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; }

  #nysm-root{
    font-family: var(--font-body);
    background:
      radial-gradient(circle at 15% 0%, rgba(255,166,48,0.18), transparent 45%),
      radial-gradient(circle at 90% 15%, rgba(230,62,124,0.20), transparent 40%),
      var(--ink);
    color: var(--cream);
    min-height:100vh;
    padding: 0 0 64px;
    line-height:1.5;
  }
  #nysm-root *{ font-family: inherit; }
  #nysm-root .deva{ font-family: var(--font-deva); }

  #nysm-root .wrap{
    max-width: 680px;
    margin: 0 auto;
    padding: 0 18px;
  }

  /* ---------------- Header / hero ---------------- */
  .nysm-hero{
    position:relative;
    padding: 40px 18px 32px;
    text-align:center;
    overflow:hidden;
    border-bottom: 1px solid var(--line);
  }
  .nysm-hero::before{
    content:"";
    position:absolute; inset:-40% -10% auto -10%;
    height: 220px;
    background: repeating-linear-gradient(90deg, var(--marigold) 0 3px, transparent 3px 26px);
    opacity:0.18;
    transform: rotate(-3deg);
  }
  .nysm-eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-size:12px; letter-spacing:.14em; text-transform:uppercase;
    color: var(--marigold-2); font-weight:700;
    background: rgba(255,166,48,0.12);
    border:1px solid rgba(255,166,48,0.35);
    padding: 6px 14px; border-radius:999px;
    margin-bottom:16px;
  }
  .nysm-title{
    font-family: var(--font-display);
    font-weight:800;
    font-size: clamp(28px, 7vw, 40px);
    margin:0 0 6px;
    background: linear-gradient(95deg, var(--marigold) 0%, var(--gulal-2) 65%, var(--gulal) 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .nysm-subtitle{
    font-size:14px; color: rgba(255,248,237,0.72); margin:0;
    max-width: 480px; margin:0 auto;
  }

  /* ---------------- Stepper ---------------- */
  .nysm-steps{
    display:flex; align-items:center; justify-content:center;
    gap:6px; padding: 22px 18px 6px; max-width:640px; margin:0 auto;
  }
  .nysm-step{
    display:flex; align-items:center; gap:6px;
    font-size:11px; font-weight:700; color: rgba(255,248,237,0.4);
  }
  .nysm-step-dot{
    width:26px; height:26px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-size:12px; font-weight:800;
    background: rgba(255,255,255,0.06);
    border: 1.5px solid rgba(255,255,255,0.18);
    transition: all .25s ease;
  }
  .nysm-step.active .nysm-step-dot{
    background: linear-gradient(135deg, var(--marigold), var(--gulal));
    border-color: transparent; color:#1B1030;
  }
  .nysm-step.done .nysm-step-dot{
    background: var(--ok); border-color: transparent; color:#fff;
  }
  .nysm-step.active{ color: var(--cream); }
  .nysm-step-bar{ width:20px; height:2px; background: rgba(255,255,255,0.18); border-radius:2px; }
  @media (max-width:420px){ .nysm-step span.label{ display:none; } }

  /* ---------------- Cards / panels ---------------- */
  .nysm-panel{
    background: var(--cream);
    color: #241338;
    border-radius: var(--radius);
    padding: 22px 20px 26px;
    margin: 18px 0;
    box-shadow: var(--shadow);
    animation: nysm-rise .35s ease both;
  }
  @keyframes nysm-rise{ from{ opacity:0; transform: translateY(10px);} to{ opacity:1; transform:none; } }

  .nysm-panel h2{
    font-family: var(--font-display);
    font-size:20px; margin: 0 0 4px; color:#1B1030;
  }
  .nysm-panel .hint{ font-size:13px; color:#6b5f80; margin:0 0 18px; }

  .nysm-field{ margin-bottom:16px; }
  .nysm-field label{
    display:block; font-size:12.5px; font-weight:700; margin-bottom:6px;
    color:#3d2c58; letter-spacing:.01em;
  }
  .nysm-field label .req{ color: var(--gulal); }
  .nysm-field input, .nysm-field select{
    width:100%; padding: 12px 14px; font-size:15px;
    border-radius: var(--radius-sm); border: 1.5px solid #E4D9CC;
    background:#fff; color:#241338; font-family: inherit;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .nysm-field input:focus, .nysm-field select:focus{
    outline:none; border-color: var(--gulal); box-shadow: 0 0 0 3px rgba(230,62,124,0.15);
  }
  .nysm-field .err-msg{ font-size:12px; color: var(--err); margin-top:5px; display:none; font-weight:600; }
  .nysm-field.invalid input, .nysm-field.invalid select{ border-color: var(--err); }
  .nysm-field.invalid .err-msg{ display:block; }

  .nysm-row2{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  @media (max-width:420px){ .nysm-row2{ grid-template-columns:1fr; } }

  .nysm-pill-group{ display:flex; gap:10px; flex-wrap:wrap; }
  .nysm-pill{
    flex:1; min-width:90px; text-align:center; cursor:pointer;
    padding:10px 8px; border-radius: var(--radius-sm);
    border:1.5px solid #E4D9CC; background:#fff; font-weight:700; font-size:13px;
    color:#3d2c58; transition: all .15s ease; user-select:none;
  }
  .nysm-pill.selected{
    border-color: var(--gulal); background: linear-gradient(135deg, #FFE9F1, #FFF3E0);
    color: var(--gulal); box-shadow: 0 0 0 3px rgba(230,62,124,0.12);
  }

  /* ---------------- Multi Event Cards ---------------- */
  .nysm-event-card{
    border:1.5px solid #E4D9CC; border-radius: var(--radius-sm);
    padding:14px; margin-bottom:12px; cursor:pointer;
    display:flex; justify-content:space-between; align-items:flex-start; gap:12px;
    transition: all .15s ease; background:#fff; position:relative;
  }
  .nysm-event-card:hover{ border-color: var(--marigold); transform: translateY(-1px); }
  .nysm-event-card.selected{
    border-color: var(--gulal); background: linear-gradient(135deg, #FFF6EA, #FFEBF2);
    box-shadow: 0 0 0 3px rgba(230,62,124,0.12);
  }
  .nysm-checkbox{
    width:20px; height:20px; border-radius:6px; border:2px solid #C9BDD6;
    display:inline-flex; align-items:center; justify-content:center;
    margin-right:10px; flex-shrink:0; background:#fff; font-weight:800; font-size:12px;
    color:transparent; transition: all .15s ease;
  }
  .nysm-event-card.selected .nysm-checkbox{
    background: var(--gulal); border-color: var(--gulal); color:#fff;
  }
  .nysm-event-name{ font-weight:700; font-size:14.5px; color:#241338; line-height:1.3; }
  .nysm-event-coordinators{
    font-size:11px; color:#78668f; margin-top:4px; font-weight:500;
  }
  .nysm-event-fee{ font-size:12.5px; color:#8a7a9c; margin-top:3px; font-weight:600; }
  .nysm-event-badge{
    font-size:11px; font-weight:800; color:#fff; background: var(--marigold);
    padding:4px 9px; border-radius:999px; white-space:nowrap; align-self:flex-start;
  }

  .nysm-sub-config-box{
    margin-top:10px; padding:12px; background:rgba(255,255,255,0.7);
    border-radius:var(--radius-sm); border:1px dashed #E4D9CC;
  }

  .nysm-invite-box{
    background: #FFF3E0; border: 1.5px dashed #FFA630;
    padding: 14px 16px; border-radius: var(--radius-sm);
    margin-top: 20px; font-size: 12.5px; color: #5a3809; line-height: 1.5;
  }
  .nysm-invite-box b{ color: #1B1030; }

  .nysm-btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    width:100%; padding:14px 18px; border:none; border-radius: var(--radius-sm);
    font-family: var(--font-display); font-weight:700; font-size:15.5px;
    cursor:pointer; transition: transform .12s ease, box-shadow .12s ease, opacity .12s ease;
  }
  .nysm-btn:active{ transform: scale(0.98); }
  .nysm-btn:disabled{ opacity:.45; cursor:not-allowed; }
  .nysm-btn-primary{
    background: linear-gradient(120deg, var(--marigold), var(--gulal));
    color:#fff; box-shadow: 0 10px 24px -8px rgba(230,62,124,0.55);
  }
  .nysm-btn-ghost{
    background:transparent; color:#5b4a72; border:1.5px solid #E4D9CC;
  }
  .nysm-btn-dark{
    background: var(--ink); color: var(--cream);
  }
  .nysm-btn-row{ display:flex; gap:10px; margin-top:20px; }
  .nysm-btn-row .nysm-btn-ghost{ flex:0 0 92px; }
  .nysm-btn-row .nysm-btn-primary{ flex:1; }

  /* ---------------- Summary card ---------------- */
  .nysm-summary{
    background: linear-gradient(160deg, #241338, #1B1030);
    color: var(--cream);
    border-radius: var(--radius);
    padding: 22px 20px;
    margin: 18px 0;
    box-shadow: var(--shadow);
    border: 1px solid rgba(255,166,48,0.25);
  }
  .nysm-summary h2{ font-family: var(--font-display); font-size:18px; margin:0 0 14px; color: var(--marigold-2); }
  .nysm-summary-row{
    display:flex; justify-content:space-between; align-items:flex-start;
    padding:8px 0; font-size:13.5px; border-bottom: 1px dashed rgba(255,255,255,0.12);
  }
  .nysm-summary-row span:first-child{ color: rgba(255,248,237,0.6); }
  .nysm-summary-row span:last-child{ font-weight:700; text-align:right; max-width:65%; }
  
  .nysm-events-breakdown{
    margin:10px 0; background:rgba(255,255,255,0.05); padding:10px 12px; border-radius:10px;
  }
  .nysm-events-breakdown-item{
    display:flex; justify-content:space-between; font-size:12.5px; padding:3px 0;
  }

  .nysm-summary-total{
    display:flex; justify-content:space-between; align-items:baseline;
    margin-top:14px; padding-top:14px; border-top:1px solid rgba(255,255,255,0.16);
  }
  .nysm-summary-total span:first-child{ font-size:14px; font-weight:700; }
  .nysm-summary-total span:last-child{
    font-family: var(--font-display); font-size:26px; font-weight:800; color: var(--marigold);
  }
  .nysm-summary-total.zero span:last-child{ color: var(--ok); }

  .nysm-secret-box{ margin-top:18px; }
  .nysm-secret-row{ display:flex; gap:8px; }
  .nysm-secret-row input{
    flex:1; padding:11px 13px; border-radius: var(--radius-sm); border:none;
    background: rgba(255,255,255,0.08); color: var(--cream); font-weight:600;
    border:1.5px solid rgba(255,255,255,0.18); text-transform:uppercase; letter-spacing:.04em;
  }
  .nysm-secret-row input::placeholder{ color: rgba(255,248,237,0.4); text-transform:none; letter-spacing:normal; }
  .nysm-secret-row button{
    padding:0 18px; border-radius: var(--radius-sm); border:none; font-weight:700;
    background: var(--marigold); color:#1B1030; cursor:pointer; font-size:13px;
  }
  .nysm-secret-msg{ font-size:12.5px; margin-top:8px; font-weight:600; display:none; }
  .nysm-secret-msg.ok{ color: #7EE2B8; display:block; }
  .nysm-secret-msg.bad{ color: #FF9AA6; display:block; }

  /* ---------------- Payment ---------------- */
  .nysm-payment{ text-align:center; }
  .nysm-upi-amount{ font-family: var(--font-display); font-size:28px; font-weight:800; color:#241338; margin: 4px 0 18px; }
  .nysm-payment-status{
    display:flex; align-items:center; justify-content:center; gap:10px;
    margin-top:14px; padding:12px; border-radius: var(--radius-sm);
    background:#FFF3E0; color:#8a5a1a; font-size:13.5px; font-weight:600;
  }
  .nysm-spinner{
    width:16px; height:16px; border-radius:50%;
    border:2.5px solid rgba(138,90,26,0.25); border-top-color:#8a5a1a;
    animation: nysm-spin .8s linear infinite; flex-shrink:0;
  }
  @keyframes nysm-spin{ to{ transform: rotate(360deg); } }
  .nysm-payment-status.error{ background:#FDE7E8; color:#B12B30; }
  .nysm-payment-status.error .nysm-spinner{ display:none; }
  .nysm-complimentary{
    text-align:center; padding: 26px 18px; border-radius: var(--radius-sm);
    background: linear-gradient(135deg, #E9FBF2, #FFF3E0); color:#1B6B45;
  }
  .nysm-complimentary .big{ font-family: var(--font-display); font-size:20px; font-weight:800; margin-bottom:4px; }

  /* ---------------- Ticket ---------------- */
  #nysm-ticket-render{
    background: linear-gradient(160deg, #FFF8ED, #FFEFD6);
    border-radius: var(--radius);
    padding:0; overflow:hidden; position:relative;
    box-shadow: var(--shadow); color:#241338;
  }
  .nysm-ticket-top{ padding: 24px 22px 18px; position:relative; }
  .nysm-ticket-band{
    height:6px; width:100%;
    background: repeating-linear-gradient(90deg, var(--marigold) 0 12px, var(--gulal) 12px 24px);
  }
  .nysm-ticket-event{ font-family: var(--font-display); font-weight:800; font-size:16px; color:#1B1030; margin:2px 0 6px; line-height:1.3; }
  .nysm-ticket-sub{ font-size:12px; color:#8a7a9c; margin-bottom:12px; }
  .nysm-ticket-grid{ display:grid; grid-template-columns:1fr 1fr; gap:12px 16px; margin-bottom:6px; }
  .nysm-ticket-field .k{ font-size:10.5px; text-transform:uppercase; letter-spacing:.06em; color:#8a7a9c; font-weight:700; }
  .nysm-ticket-field .v{ font-size:14px; font-weight:700; color:#241338; margin-top:2px; }
  .nysm-ticket-field.amount .v{ font-size:18px; font-weight:800; color: var(--gulal); }
  .nysm-ticket-field.amount .v.comp{ color: var(--ok); }

  .nysm-ticket-perf{
    position:relative; height:28px;
    background: repeating-linear-gradient(90deg, transparent 0 6px, rgba(36,19,56,0.18) 6px 7px);
  }
  .nysm-ticket-perf::before, .nysm-ticket-perf::after{
    content:""; position:absolute; top:50%; transform:translateY(-50%);
    width:24px; height:24px; background: var(--ink); border-radius:50%;
  }
  .nysm-ticket-perf::before{ left:-12px; }
  .nysm-ticket-perf::after{ right:-12px; }

  .nysm-ticket-bottom{ padding: 18px 22px 24px; display:flex; align-items:center; gap:16px; }
  .nysm-ticket-qr{ background:#fff; padding:8px; border-radius:10px; flex-shrink:0; }
  .nysm-ticket-note{ font-size:11.5px; color:#6b5f80; }
  .nysm-ticket-note .id{ font-family: var(--font-display); font-weight:800; color:#1B1030; font-size:13.5px; margin-bottom:4px; }
  .nysm-ticket-note .warn{ margin-top:6px; font-weight:700; color: var(--gulal); }

  .nysm-ticket-actions{ display:flex; gap:10px; margin-top:16px; }

  .nysm-toast{
    position:fixed; left:50%; bottom:24px; transform:translate(-50%, 20px);
    background:#241338; color:#fff; padding:12px 20px; border-radius:999px;
    font-size:13.5px; font-weight:600; box-shadow: var(--shadow);
    opacity:0; transition: all .25s ease; pointer-events:none; z-index:999;
    max-width:90%; text-align:center;
  }
  .nysm-toast.show{ opacity:1; transform:translate(-50%, 0); }

  .nysm-hidden{ display:none !important; }
</style>
</head>
<body>

<div id="nysm-root">
  <div class="nysm-hero">
    <div class="wrap">
      <span class="nysm-eyebrow">✦ Registration Open · 2026 ✦</span>
      <h1 class="nysm-title deva">नवचेतना युवा शक्ति महोत्सव</h1>
      <p class="nysm-subtitle">Select single or multiple events and get your consolidated pass instantly.</p>
    </div>
  </div>

  <div class="nysm-steps" id="nysm-stepper">
    <div class="nysm-step active" data-step="1"><div class="nysm-step-dot">1</div><span class="label">Details</span></div>
    <div class="nysm-step-bar"></div>
    <div class="nysm-step" data-step="2"><div class="nysm-step-dot">2</div><span class="label">Events</span></div>
    <div class="nysm-step-bar"></div>
    <div class="nysm-step" data-step="3"><div class="nysm-step-dot">3</div><span class="label">Pay</span></div>
    <div class="nysm-step-bar"></div>
    <div class="nysm-step" data-step="4"><div class="nysm-step-dot">4</div><span class="label">Ticket</span></div>
  </div>

  <div class="wrap">

    <!-- STEP 1 : Participant details -->
    <section class="nysm-panel" id="nysm-step-1">
      <h2>Participant Details</h2>
      <p class="hint">Tell us who is registering.</p>

      <div class="nysm-field" data-field="fullName">
        <label>Full Name <span class="req">*</span></label>
        <input type="text" id="f-fullName" placeholder="Enter full name" autocomplete="name">
        <div class="err-msg">Please enter the participant's full name.</div>
      </div>

      <div class="nysm-field" data-field="mobile">
        <label>Mobile Number <span class="req">*</span></label>
        <input type="tel" id="f-mobile" placeholder="10-digit mobile number" maxlength="10" autocomplete="tel">
        <div class="err-msg">Enter a valid 10-digit mobile number.</div>
      </div>

      <div class="nysm-field" data-field="school">
        <label>College / School <span class="req">*</span></label>
        <input type="text" id="f-school" placeholder="Institute name">
        <div class="err-msg">Please enter your college or school name.</div>
      </div>

      <div class="nysm-row2">
        <div class="nysm-field" data-field="classCourse">
          <label>Class / Course <span class="req">*</span></label>
          <input type="text" id="f-classCourse" placeholder="e.g. B.Tech / BCA / 12th">
          <div class="err-msg">Required.</div>
        </div>
        <div class="nysm-field" data-field="age">
          <label>Age (4 - 40 Years) <span class="req">*</span></label>
          <input type="number" id="f-age" min="4" max="40" placeholder="e.g. 19">
          <div class="err-msg">Please enter a valid age between 4 and 40.</div>
        </div>
      </div>

      <div class="nysm-row2">
        <div class="nysm-field" data-field="teamSlot">
          <label>Team / Slot Number <span style="font-weight:normal; color:#8a7a9c;">(Optional)</span></label>
          <input type="text" id="f-teamSlot" placeholder="e.g. Slot-A / Team-04">
        </div>
        <div class="nysm-field" data-field="reference">
          <label>Reference Name <span style="font-weight:normal; color:#8a7a9c;">(Optional)</span></label>
          <input type="text" id="f-reference" placeholder="Who referred you?">
        </div>
      </div>

      <div class="nysm-field" data-field="category">
        <label>Category <span class="req">*</span></label>
        <div class="nysm-pill-group" id="f-category">
          <div class="nysm-pill" data-value="Junior">Junior (Up to 12th)</div>
          <div class="nysm-pill" data-value="Senior">Senior (College / Open)</div>
        </div>
        <div class="err-msg">Select a category.</div>
      </div>

      <div class="nysm-field" data-field="gender">
        <label>Gender <span class="req">*</span></label>
        <div class="nysm-pill-group" id="f-gender">
          <div class="nysm-pill" data-value="Male">Male</div>
          <div class="nysm-pill" data-value="Female">Female</div>
        </div>
        <div class="err-msg">Select a gender.</div>
      </div>

      <button class="nysm-btn nysm-btn-primary" onclick="NYSM.goToStep(2)">Continue to Event Selection →</button>
    </section>

    <!-- STEP 2 : Multi-Event selection -->
    <section class="nysm-panel nysm-hidden" id="nysm-step-2">
      <h2>Choose Competition Events</h2>
      <p class="hint">Select <b>one or more</b> events to participate in<span id="f-category-echo"></span>.</p>
      
      <div id="nysm-event-list"></div>

      <!-- Invite Only Section Note -->
      

      <div class="nysm-btn-row">
        <button class="nysm-btn nysm-btn-ghost" onclick="NYSM.goToStep(1)">← Back</button>
        <button class="nysm-btn nysm-btn-primary" id="nysm-to-step3" disabled onclick="NYSM.goToStep(3)">Review & Pay (₹0) →</button>
      </div>
    </section>

    <!-- STEP 3 : Summary + Secret code + Payment -->
    <section class="nysm-hidden" id="nysm-step-3">
      <div class="nysm-summary">
        <h2>Registration Summary</h2>
        <div class="nysm-summary-row"><span>Participant</span><span id="s-name">—</span></div>
        <div class="nysm-summary-row"><span>Mobile</span><span id="s-mobile">—</span></div>
        <div class="nysm-summary-row"><span>Age / Category</span><span id="s-age-cat">—</span></div>
        <div class="nysm-summary-row nysm-hidden" id="s-team-row"><span>Team / Slot No.</span><span id="s-teamSlot">—</span></div>
        
        <div style="margin-top:10px; font-size:12.5px; color:rgba(255,248,237,0.7); font-weight:700;">Selected Events & Fee:</div>
        <div class="nysm-events-breakdown" id="s-events-breakdown"></div>

        <div class="nysm-summary-row nysm-hidden" id="s-code-row"><span>Secret Code</span><span id="s-code">—</span></div>

        <div class="nysm-summary-total" id="s-total-row">
          <span>Total Amount Payable</span>
          <span id="s-total">₹0</span>
        </div>

        <div class="nysm-secret-box">
          <label style="display:block; font-size:12.5px; font-weight:700; margin-bottom:6px; color: var(--marigold-2);">Secret Code (Optional)</label>
          <div class="nysm-secret-row">
            <input type="text" id="f-secretCode" placeholder="VIP / SPONSOR / STAFF CODE">
            <button onclick="NYSM.applySecretCode()">Apply</button>
          </div>
          <div class="nysm-secret-msg" id="secret-msg"></div>
        </div>
      </div>

      <div class="nysm-panel nysm-payment" id="nysm-payment-panel">
        <h2>Complete Payment</h2>
        <p class="hint" id="payment-hint">Pay securely with Razorpay — UPI, Cards, Netbanking & Wallets.</p>

        <div class="nysm-upi-amount" id="upi-amount-label">₹0</div>

        <button class="nysm-btn nysm-btn-primary" id="nysm-pay-btn" onclick="NYSM.startPayment()">🔒 Pay Now</button>

        <div class="nysm-payment-status nysm-hidden" id="nysm-payment-status">
          <div class="nysm-spinner"></div>
          <span id="nysm-payment-status-text">Waiting for payment confirmation…</span>
        </div>

        <button class="nysm-btn nysm-btn-ghost nysm-hidden" id="nysm-recheck-btn" style="margin-top:10px;" onclick="NYSM.recheckStatus()">↻ I've Paid — Check Status</button>
      </div>

      <div class="nysm-panel nysm-complimentary nysm-hidden" id="nysm-comp-panel">
        <div class="big">🎟 Complimentary Entry</div>
        <p style="margin:0; font-size:13.5px;">Valid secret code applied — 100% discount granted.</p>
        <button class="nysm-btn nysm-btn-dark" id="nysm-comp-confirm-btn" style="margin-top:16px;" onclick="NYSM.confirmComplimentary()">Confirm Registration →</button>
      </div>

      <div class="nysm-btn-row wrap" style="max-width:680px; margin:0 auto;">
        <button class="nysm-btn nysm-btn-ghost" onclick="NYSM.goToStep(2)">← Back</button>
      </div>
    </section>

    <!-- STEP 4 : Ticket -->
    <section class="nysm-panel nysm-hidden" id="nysm-step-4" style="background:transparent; box-shadow:none; padding:0;">
      <div id="nysm-ticket-render">
        <div class="nysm-ticket-band"></div>
        <div class="nysm-ticket-top">
          <div class="nysm-ticket-sub">NAVCHETNA YUVA SHAKTI MAHOTSAV 2026 · CONSOLIDATED PASS</div>
          <div class="nysm-ticket-event" id="t-event">—</div>
          <div class="nysm-ticket-grid">
            <div class="nysm-ticket-field"><div class="k">Participant</div><div class="v" id="t-name">—</div></div>
            <div class="nysm-ticket-field"><div class="k">Mobile</div><div class="v" id="t-mobile">—</div></div>
            <div class="nysm-ticket-field"><div class="k">Age / Category</div><div class="v" id="t-category">—</div></div>
            <div class="nysm-ticket-field amount"><div class="k" id="t-amount-label">Amount Paid</div><div class="v" id="t-amount">—</div></div>
            <div class="nysm-ticket-field nysm-hidden" id="t-slot-field"><div class="k">Team / Slot</div><div class="v" id="t-teamslot">—</div></div>
          </div>
        </div>
        <div class="nysm-ticket-perf"></div>
        <div class="nysm-ticket-bottom">
          <div class="nysm-ticket-qr" id="nysm-ticket-qrcode"></div>
          <div class="nysm-ticket-note">
            <div class="id" id="t-ticketid">NYSM26-000000</div>
            <div>Entry valid for all selected events listed above.</div>
            <div class="warn">Please carry your valid photo ID.</div>
          </div>
        </div>
      </div>
      <div class="nysm-ticket-actions">
        <button class="nysm-btn nysm-btn-ghost" onclick="NYSM.printTicket()">🖨 Print</button>
        <button class="nysm-btn nysm-btn-primary" onclick="NYSM.downloadTicket()">⬇ Download Ticket</button>
      </div>
      <button class="nysm-btn nysm-btn-dark" style="margin-top:10px;" onclick="NYSM.resetForm()">Register Another Participant</button>
    </section>

  </div>
</div>

<div class="nysm-toast" id="nysm-toast"></div>

<!-- QR code & export scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
(function(){

  const CONFIG = {
    API_BASE_URL: "/api",
    RAZORPAY_KEY_ID: "<%= process.env.RAZORPAY_KEY_ID || 'rzp_live_TM9kT7z1INgJKh' %>"
  };

  /* ==========================================================================
     EVENT CATALOGUE: E-Sports with Solo / Squad (Max 4)
     ========================================================================== */
  const EVENTS = [
    { 
      id: "esports", 
      name: "E-Sports Championship", 
      coordinators: "Akash Narvariya, Vikash Narvariya", 
      isEsports: true,
      solo: { junior: 200, senior: 200 },
      group: { junior: 200, senior: 200 } // ₹200 Flat for Squad
    },
    { 
      id: "rangotsav", 
      name: "रंगोत्सव : Drawing Competition", 
      coordinators: "Shalini Shukla, Arpit Sharma, Babli Kushwah, Betal Ken", 
      junior: 20, senior: 50 
    },
    { 
      id: "bharatbodh", 
      name: "भारत बोध : Quiz Competition", 
      coordinators: "Jatin Soni, Harshita Yadav", 
      junior: 20, senior: 50 
    },
    { 
      id: "techmanthan", 
      name: "Tech Manthan Hackathon", 
      coordinators: "Rahul Kushwaha, Chitransh Shrivastava, Jayesh Shrivastava", 
      junior: 99, senior: 99 
    },
    { 
      id: "yuvavani", 
      name: "युवा-वाणी : Open Mic", 
      coordinators: "Rhythem Raizada, Khushi Sharma, Anshika Sharma", 
      junior: 49, senior: 99 
    },
    { 
      id: "loknritya", 
      name: "लोकनृत्य : Dance Competition", 
      coordinators: "Nishu Sikarwar, Raj Prajapati, Ganga Sharma, Dinesh Jeevtani", 
      dance: true,
      solo: { junior: 49, senior: 99 }, 
      group: { junior: 20, senior: 50 } 
    },
    { 
      id: "expo", 
      name: "Business & Exhibition Expo", 
      coordinators: "Rashi Shirothiya, Shweta Chauhan, Kirtan Gurjar, Naman Jain", 
      junior: 49, senior: 99 
    },
    { 
      id: "rangebharat", 
      name: "रंग-ए-भारत : Cultural Fashion Show", 
      coordinators: "Anshika Sharma, Sarthak Sahu", 
      junior: 49, senior: 99 
    },
    { 
      id: "beyondframe", 
      name: "Beyond the Frame : Photography & Reel Competition", 
      coordinators: "Aman Gupta, Muskan Khan", 
      junior: 99, senior: 99 
    },
    { 
      id: "fungames", 
      name: "Fun & Game Zone", 
      coordinators: "Pratyasha Singh, Lavanya Sharma, Shubham Malik", 
      junior: 20, senior: 50 
    },
    { 
      id: "kalamkar", 
      name: "कलमकार : Essay Competition", 
      coordinators: "Arman Khan, Kalpana Mudgal", 
      junior: 20, senior: 50 
    },
    { 
      id: "dharmagatha", 
      name: "धर्मगाथा : रामायण - महाभारत ज्ञान क्विज", 
      coordinators: "Vivek Bhadauria, Gunjan Jha", 
      junior: 20, senior: 50 
    }
  ];

  /* State */
  const state = {
    fullName: "", mobile: "", school: "", classCourse: "", age: "",
    teamSlot: "", category: "", gender: "", reference: "",
    selectedEvents: {}, 
    fee: 0, secretCode: "", secretValid: false,
    ticketId: "", paymentStatus: "", orderId: ""
  };

  function getEventFee(ev, category, participantType, groupCount) {
    if (!category) return 0;

    if (ev.dance) {
      if (participantType === "Solo") {
        return category === "Junior" ? ev.solo.junior : ev.solo.senior;
      }
      if (participantType === "Group") {
        const per = category === "Junior" ? ev.group.junior : ev.group.senior;
        const n = Math.max(parseInt(groupCount, 10) || 0, 0);
        return per * n;
      }
      return category === "Junior" ? ev.solo.junior : ev.solo.senior;
    }
    
    // E-Sports calculation (Solo vs Squad flat ₹200)
    if (ev.isEsports) {
      if (participantType === "Group" || participantType === "Squad") {
        return category === "Junior" ? ev.group.junior : ev.group.senior;
      }
      return category === "Junior" ? ev.solo.junior : ev.solo.senior;
    }

    return category === "Junior" ? ev.junior : ev.senior;
  }

  function toast(msg){
    const t = document.getElementById('nysm-toast');
    t.textContent = msg; t.classList.add('show');
    clearTimeout(window._nysmToastTimer);
    window._nysmToastTimer = setTimeout(()=> t.classList.remove('show'), 2600);
  }

  function setStepper(step){
    document.querySelectorAll('#nysm-stepper .nysm-step').forEach(el=>{
      const n = parseInt(el.dataset.step,10);
      el.classList.toggle('active', n === step);
      el.classList.toggle('done', n < step);
    });
  }

  function showPanel(step){
    [1,2,3,4].forEach(n=>{
      document.getElementById('nysm-step-'+n).classList.toggle('nysm-hidden', n !== step);
    });
    setStepper(step);
    document.getElementById('nysm-root').scrollIntoView({behavior:'smooth', block:'start'});
  }

  function markInvalid(name, invalid){
    const el = document.querySelector('.nysm-field[data-field="'+name+'"]');
    if(el) el.classList.toggle('invalid', invalid);
  }

  /* Step 1 Handlers */
  document.querySelectorAll('#f-category .nysm-pill').forEach(p=>{
    p.addEventListener('click', ()=>{
      document.querySelectorAll('#f-category .nysm-pill').forEach(x=>x.classList.remove('selected'));
      p.classList.add('selected');
      state.category = p.dataset.value;
      markInvalid('category', false);
      recalcTotalFee();
    });
  });
  document.querySelectorAll('#f-gender .nysm-pill').forEach(p=>{
    p.addEventListener('click', ()=>{
      document.querySelectorAll('#f-gender .nysm-pill').forEach(x=>x.classList.remove('selected'));
      p.classList.add('selected');
      state.gender = p.dataset.value;
      markInvalid('gender', false);
    });
  });

  function validateStep1(){
    let ok = true;
    state.fullName = document.getElementById('f-fullName').value.trim();
    state.mobile = document.getElementById('f-mobile').value.trim();
    state.school = document.getElementById('f-school').value.trim();
    state.classCourse = document.getElementById('f-classCourse').value.trim();
    
    const ageVal = parseInt(document.getElementById('f-age').value.trim(), 10);
    state.age = isNaN(ageVal) ? "" : ageVal;
    
    state.teamSlot = document.getElementById('f-teamSlot').value.trim();
    state.reference = document.getElementById('f-reference').value.trim();

    const checks = [
      ['fullName', state.fullName.length >= 2],
      ['mobile', /^[6-9]\d{9}$/.test(state.mobile)],
      ['school', state.school.length >= 2],
      ['classCourse', state.classCourse.length >= 1],
      ['age', state.age !== "" && state.age >= 4 && state.age <= 40],
      ['category', !!state.category],
      ['gender', !!state.gender],
    ];
    checks.forEach(([field, valid])=>{
      markInvalid(field, !valid);
      if(!valid) ok = false;
    });
    return ok;
  }

  /* Step 2 Multi-Event Render */
  function renderEvents(){
    const list = document.getElementById('nysm-event-list');
    document.getElementById('f-category-echo').textContent = state.category ? (' — ' + state.category) : '';
    list.innerHTML = '';

    EVENTS.forEach(ev=>{
      const isSelected = !!state.selectedEvents[ev.id];
      const card = document.createElement('div');
      card.className = 'nysm-event-card' + (isSelected ? ' selected' : '');
      
      let feeText;
      if(ev.dance){
        feeText = `Solo: ₹${ev.solo[state.category==='Junior'?'junior':'senior']} | Group: ₹${ev.group[state.category==='Junior'?'junior':'senior']}/member`;
      } else if(ev.isEsports) {
        feeText = `Solo: ₹${ev.solo.senior} | Squad (Max 4): ₹${ev.group.senior}/team`;
      } else {
        feeText = `Fee: ₹${state.category==='Junior' ? ev.junior : ev.senior}`;
      }

      card.innerHTML = `
        <div style="display:flex; width:100%;">
          <div class="nysm-checkbox">${isSelected ? '✓' : ''}</div>
          <div style="flex:1;">
            <div class="nysm-event-name">${ev.name}</div>
            <div class="nysm-event-coordinators">Coordinators: ${ev.coordinators}</div>
            <div class="nysm-event-fee">${feeText}</div>
            
            <!-- Dance Sub-options -->
            ${ev.dance && isSelected ? `
              <div class="nysm-sub-config-box" onclick="event.stopPropagation()">
                <label style="font-size:12px; font-weight:700; color:#3d2c58;">Participation Mode:</label>
                <div style="display:flex; gap:8px; margin:6px 0;">
                  <button type="button" class="nysm-pill ${(!state.selectedEvents[ev.id].participantType || state.selectedEvents[ev.id].participantType==='Solo')?'selected':''}" style="padding:6px; font-size:12px;" onclick="NYSM.setSubOption('${ev.id}', 'Solo')">Solo</button>
                  <button type="button" class="nysm-pill ${state.selectedEvents[ev.id].participantType==='Group'?'selected':''}" style="padding:6px; font-size:12px;" onclick="NYSM.setSubOption('${ev.id}', 'Group')">Group</button>
                </div>
                ${state.selectedEvents[ev.id].participantType==='Group' ? `
                  <input type="number" min="2" max="15" placeholder="Number of Members (min 2)" value="${state.selectedEvents[ev.id].groupCount||''}" oninput="NYSM.setGroupCount('${ev.id}', this.value)" style="padding:8px; font-size:13px; width:100%; border:1px solid #E4D9CC; border-radius:8px;">
                ` : ''}
              </div>
            ` : ''}

            <!-- E-Sports Sub-options (Solo vs Squad/Group - Max 4 Members) -->
            ${ev.isEsports && isSelected ? `
              <div class="nysm-sub-config-box" onclick="event.stopPropagation()">
                <label style="font-size:12px; font-weight:700; color:#3d2c58;">E-Sports Mode:</label>
                <div style="display:flex; gap:8px; margin:6px 0;">
                  <button type="button" class="nysm-pill ${(!state.selectedEvents[ev.id].participantType || state.selectedEvents[ev.id].participantType==='Solo')?'selected':''}" style="padding:6px; font-size:12px;" onclick="NYSM.setSubOption('${ev.id}', 'Solo')">Solo (₹200)</button>
                  <button type="button" class="nysm-pill ${state.selectedEvents[ev.id].participantType==='Group'?'selected':''}" style="padding:6px; font-size:12px;" onclick="NYSM.setSubOption('${ev.id}', 'Group')">Squad (₹200/Team)</button>
                </div>
                ${state.selectedEvents[ev.id].participantType==='Group' ? `
                  <div style="margin-top:6px; display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                    <input type="text" placeholder="Squad / Team Name" value="${state.selectedEvents[ev.id].teamName||''}" oninput="NYSM.setTeamName('${ev.id}', this.value)" style="padding:8px; font-size:12.5px; border:1px solid #E4D9CC; border-radius:8px;">
                    <input type="number" min="2" max="4" placeholder="Players (2 to 4)" value="${state.selectedEvents[ev.id].groupCount||''}" oninput="NYSM.setGroupCount('${ev.id}', this.value)" style="padding:8px; font-size:12.5px; border:1px solid #E4D9CC; border-radius:8px;">
                  </div>
                  <small style="color:#78668f; font-size:11px; margin-top:3px; display:block;">* Maximum 4 players per squad.</small>
                ` : ''}
              </div>
            ` : ''}

          </div>
          <div class="nysm-event-badge">${state.category || '—'}</div>
        </div>
      `;

      card.addEventListener('click', () => toggleEvent(ev));
      list.appendChild(card);
    });

    recalcTotalFee();
  }

  function toggleEvent(ev){
    if(state.selectedEvents[ev.id]){
      delete state.selectedEvents[ev.id];
    } else {
      state.selectedEvents[ev.id] = {
        id: ev.id,
        name: ev.name,
        coordinators: ev.coordinators,
        participantType: (ev.dance || ev.isEsports) ? 'Solo' : '',
        groupCount: (ev.dance || ev.isEsports) ? 1 : 0,
        teamName: ""
      };
    }
    renderEvents();
  }

  function setSubOption(eventId, type){
    if(state.selectedEvents[eventId]){
      state.selectedEvents[eventId].participantType = type;
      if(type === 'Group'){
        state.selectedEvents[eventId].groupCount = eventId === 'esports' ? 4 : 2;
      } else {
        state.selectedEvents[eventId].groupCount = 1;
      }
      renderEvents();
    }
  }

  function setGroupCount(eventId, count){
    if(state.selectedEvents[eventId]){
      let val = parseInt(count, 10) || 0;
      if (eventId === 'esports' && val > 4) {
        val = 4;
        toast('Maximum squad size for E-Sports is 4 players.');
      }
      state.selectedEvents[eventId].groupCount = val;
      recalcTotalFee();
    }
  }

  function setTeamName(eventId, name){
    if(state.selectedEvents[eventId]){
      state.selectedEvents[eventId].teamName = name;
    }
  }

  function recalcTotalFee(){
    let sum = 0;
    const selectedKeys = Object.keys(state.selectedEvents);

    selectedKeys.forEach(id=>{
      const ev = EVENTS.find(e=>e.id===id);
      if(ev){
        const item = state.selectedEvents[id];
        item.fee = getEventFee(ev, state.category, item.participantType, item.groupCount);
        sum += item.fee;
      }
    });

    state.fee = sum;
    const btn = document.getElementById('nysm-to-step3');
    if(btn){
      btn.disabled = selectedKeys.length === 0;
      btn.textContent = `Review & Pay (₹${sum}) →`;
    }
  }

  /* Step 3 Summary */
  function renderSummary(){
    document.getElementById('s-name').textContent = state.fullName || '—';
    document.getElementById('s-mobile').textContent = state.mobile || '—';
    document.getElementById('s-age-cat').textContent = `${state.age} Yrs · ${state.category || '—'}`;

    const teamRow = document.getElementById('s-team-row');
    if (state.teamSlot) {
      teamRow.classList.remove('nysm-hidden');
      document.getElementById('s-teamSlot').textContent = state.teamSlot;
    } else {
      teamRow.classList.add('nysm-hidden');
    }

    const breakdown = document.getElementById('s-events-breakdown');
    breakdown.innerHTML = '';

    Object.values(state.selectedEvents).forEach(ev=>{
      const row = document.createElement('div');
      row.className = 'nysm-events-breakdown-item';
      
      let details = '';
      if(ev.participantType === 'Group'){
        details = ` (Squad/Group${ev.teamName ? ' - Team: '+ev.teamName : ''} [${ev.groupCount} Members])`;
      } else if(ev.participantType === 'Solo'){
        details = ' (Solo)';
      }

      row.innerHTML = `<span>• ${ev.name}${details}</span><span>₹${ev.fee}</span>`;
      breakdown.appendChild(row);
    });

    resetPaymentUI();
    updateTotalDisplay();
  }

  function updateTotalDisplay(){
    const total = state.secretValid ? 0 : state.fee;
    document.getElementById('s-total').textContent = '₹' + total;
    document.getElementById('s-total-row').classList.toggle('zero', state.secretValid);
    document.getElementById('upi-amount-label').textContent = '₹' + total;

    document.getElementById('nysm-payment-panel').classList.toggle('nysm-hidden', state.secretValid);
    document.getElementById('nysm-comp-panel').classList.toggle('nysm-hidden', !state.secretValid);

    const codeRow = document.getElementById('s-code-row');
    if(state.secretValid){
      codeRow.classList.remove('nysm-hidden');
      document.getElementById('s-code').textContent = state.secretCode;
    } else {
      codeRow.classList.add('nysm-hidden');
    }
  }

  async function applySecretCode(){
    const val = document.getElementById('f-secretCode').value.trim().toUpperCase();
    const msg = document.getElementById('secret-msg');
    
    if(!val){
      msg.className = 'nysm-secret-msg bad';
      msg.textContent = 'Enter a code to apply.';
      return;
    }

    try{
      const res = await backendCall('validate-secret-code', { secretCode: val }, 'POST');
      if(res.valid){
        state.secretCode = val;
        state.secretValid = true;
        msg.className = 'nysm-secret-msg ok';
        msg.textContent = `✓ ${res.message} (${res.label})`;
      } else {
        state.secretValid = false;
        state.secretCode = '';
        msg.className = 'nysm-secret-msg bad';
        msg.textContent = res.message || 'Invalid Secret Code.';
      }
    } catch(err){
      state.secretValid = false;
      state.secretCode = '';
      msg.className = 'nysm-secret-msg bad';
      msg.textContent = 'Could not validate code. Please try again.';
    }
    updateTotalDisplay();
  }

  function resetPaymentUI(){
    document.getElementById('nysm-pay-btn').disabled = false;
    document.getElementById('nysm-pay-btn').classList.remove('nysm-hidden');
    document.getElementById('nysm-pay-btn').textContent = '🔒 Pay Now';
    const statusBox = document.getElementById('nysm-payment-status');
    statusBox.classList.add('nysm-hidden');
    statusBox.classList.remove('error');
    document.getElementById('nysm-recheck-btn').classList.add('nysm-hidden');
    state.orderId = "";
  }

  function setStatusMessage(text, isError){
    const statusBox = document.getElementById('nysm-payment-status');
    statusBox.classList.remove('nysm-hidden');
    statusBox.classList.toggle('error', !!isError);
    document.getElementById('nysm-payment-status-text').textContent = text;
  }

  async function backendCall(action, payload, method){
    let url = `${CONFIG.API_BASE_URL}/${action}`;
    let options = { method: method || 'POST' };

    if(method === 'GET'){
      const qs = new URLSearchParams(payload).toString();
      url += `?${qs}`;
    } else {
      options.headers = { 'Content-Type': 'application/json' };
      options.body = JSON.stringify(payload);
    }

    const resp = await fetch(url, options);
    if(!resp.ok){
      const errData = await resp.json().catch(() => ({}));
      throw new Error(errData.error || `Server error: ${resp.status}`);
    }
    return resp.json();
  }

  async function startPayment(){
    if(typeof Razorpay === 'undefined'){
      toast('Payment SDK failed to load — check your connection and retry.');
      return;
    }
    const payBtn = document.getElementById('nysm-pay-btn');
    payBtn.disabled = true;
    payBtn.textContent = 'Preparing secure order…';
    document.getElementById('nysm-recheck-btn').classList.add('nysm-hidden');

    try{
      const order = await backendCall('create-order', {
        amount: state.fee
      }, 'POST');

      if(order.error) throw new Error(order.error);

      state.orderId = order.orderId;
      payBtn.classList.add('nysm-hidden');
      setStatusMessage('Opening secure Razorpay checkout…', false);

      const rzp = new Razorpay({
        key: order.keyId || CONFIG.RAZORPAY_KEY_ID,
        amount: order.amount,
        currency: order.currency || "INR",
        order_id: order.orderId,
        name: 'Navchetna Yuva Shakti Mahotsav',
        description: `Pass (${Object.keys(state.selectedEvents).length} events)`,
        prefill: {
          name: state.fullName,
          contact: state.mobile
        },
        theme: { color: '#E63E7C' },
        handler: function(response){
          setStatusMessage('Verifying your payment…', false);
          verifyPayment(response);
        },
        modal: {
          ondismiss: function(){
            setStatusMessage('Payment window closed. Click below once you\'ve paid, or try again.', true);
            document.getElementById('nysm-recheck-btn').classList.remove('nysm-hidden');
            payBtn.classList.remove('nysm-hidden');
            payBtn.disabled = false;
            payBtn.textContent = '🔒 Try Payment Again';
          }
        }
      });

      rzp.on('payment.failed', function(response){
        setStatusMessage('Payment failed: ' + (response.error && response.error.description || 'please try again.'), true);
        document.getElementById('nysm-recheck-btn').classList.remove('nysm-hidden');
        payBtn.classList.remove('nysm-hidden');
        payBtn.disabled = false;
        payBtn.textContent = '🔒 Try Payment Again';
      });

      rzp.open();

    } catch(err){
      setStatusMessage('Could not start payment: ' + err.message, true);
      payBtn.classList.remove('nysm-hidden');
      payBtn.disabled = false;
      payBtn.textContent = '🔒 Pay Now';
    }
  }

  /* Safe Payment Verification Handler */
  async function verifyPayment(response){
    try{
      const eventsArray = Object.values(state.selectedEvents).map(e => ({
        id: String(e.id || ""),
        name: String(e.name || ""),
        coordinators: String(e.coordinators || ""),
        fee: Number(e.fee) || 0,
        participantType: String(e.participantType || "Solo"),
        groupCount: parseInt(e.groupCount, 10) || 1,
        teamName: String(e.teamName || "")
      }));

      const result = await backendCall('verify-payment', {
        razorpay_order_id: response.razorpay_order_id,
        razorpay_payment_id: response.razorpay_payment_id,
        razorpay_signature: response.razorpay_signature,
        participantData: {
          fullName: state.fullName,
          mobile: state.mobile,
          school: state.school,
          classCourse: state.classCourse,
          age: parseInt(state.age, 10) || 18,
          teamSlot: state.teamSlot || "",
          category: state.category,
          gender: state.gender,
          reference: state.reference,
          events: eventsArray,
          amount: state.fee
        }
      }, 'POST');

      if (result && result.ticketId) {
        state.ticketId = result.ticketId;
        state.paymentStatus = 'Paid';
        renderTicket();
        showPanel(4);
        toast('Payment confirmed — Pass generated!');
      } else {
        throw new Error(result.error || 'Payment recorded but ticket could not load.');
      }

    } catch(err){
      console.error("Payment verify error:", err);
      setStatusMessage('Status: ' + err.message + ' — click below to recheck.', true);
      const recheckBtn = document.getElementById('nysm-recheck-btn');
      if (recheckBtn) recheckBtn.classList.remove('nysm-hidden');
    }
  }

  function recheckStatus(){
    if(!state.orderId){ toast('No payment in progress.'); return; }
    setStatusMessage('Checking status with server…', false);
    backendCall('check-status', { orderId: state.orderId }, 'GET').then(data=>{
      if(data.status === 'PAID'){
        state.ticketId = data.ticketId;
        state.paymentStatus = 'Paid';
        renderTicket();
        showPanel(4);
        toast('Payment confirmed — Pass generated!');
      } else {
        setStatusMessage('Payment not confirmed yet. Please retry or contact support.', true);
      }
    }).catch(()=>{
      setStatusMessage('Server connection error. Please retry.', true);
    });
  }

  /* Safe Complimentary Registration Handler */
  async function confirmComplimentary(){
    const btn = document.getElementById('nysm-comp-confirm-btn');
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Generating Ticket…';
    }

    const eventsArray = Object.values(state.selectedEvents).map(e => ({
      id: String(e.id || ""),
      name: String(e.name || ""),
      coordinators: String(e.coordinators || ""),
      fee: 0,
      participantType: String(e.participantType || "Solo"),
      groupCount: parseInt(e.groupCount, 10) || 1,
      teamName: String(e.teamName || "")
    }));

    try{
      const result = await backendCall('record-complimentary', {
        fullName: state.fullName,
        mobile: state.mobile,
        school: state.school,
        classCourse: state.classCourse,
        age: parseInt(state.age, 10) || 18,
        teamSlot: state.teamSlot || "",
        category: state.category || "Senior",
        gender: state.gender || "Male",
        reference: state.reference || "",
        events: eventsArray,
        secretCode: state.secretCode
      }, 'POST');

      if (!result || result.error) {
        throw new Error(result ? result.error : "Server did not return ticket information.");
      }

      state.ticketId = result.ticketId;
      state.paymentStatus = 'Complimentary Entry';

      renderTicket();
      showPanel(4);
      toast('Registration confirmed — ticket generated!');

    } catch(err){
      console.error("Complimentary registration error:", err);
      toast('Registration notice: ' + err.message);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Confirm Registration →';
      }
    }
  }

  /* Resilient Ticket Rendering with Clean QR Payload */
  function renderTicket(){
    try {
      const selectedList = Object.values(state.selectedEvents || {});
      let evNames = "Mahotsav Pass";
      if (selectedList.length > 0) {
        evNames = selectedList.map(e => {
          let extra = e.participantType === 'Group' ? ` (${e.teamName ? e.teamName + ' - ' : ''}${e.groupCount || 4}P)` : '';
          return (e.name || "Event") + extra;
        }).join(' • ');
      }

      const setSafeText = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val || '—';
      };

      setSafeText('t-event', evNames);
      setSafeText('t-name', state.fullName);
      setSafeText('t-mobile', state.mobile);
      setSafeText('t-category', `${state.age || 18} Yrs · ${state.category || 'Senior'}`);
      setSafeText('t-ticketid', state.ticketId || 'NYSM26-TICKET');

      const slotField = document.getElementById('t-slot-field');
      if (slotField) {
        if (state.teamSlot) {
          slotField.classList.remove('nysm-hidden');
          setSafeText('t-teamslot', state.teamSlot);
        } else {
          slotField.classList.add('nysm-hidden');
        }
      }

      const amountLabel = document.getElementById('t-amount-label');
      const amountVal = document.getElementById('t-amount');
      if (amountLabel && amountVal) {
        if (state.paymentStatus === 'Complimentary Entry') {
          amountLabel.textContent = 'Status';
          amountVal.textContent = 'Complimentary';
          amountVal.classList.add('comp');
        } else {
          amountLabel.textContent = 'Amount Paid';
          amountVal.textContent = '₹' + (state.fee || 0);
          amountVal.classList.remove('comp');
        }
      }

      const qrHolder = document.getElementById('nysm-ticket-qrcode');
      if (qrHolder) {
        qrHolder.innerHTML = '';
        if (typeof QRCode !== 'undefined') {
          const qrData = `TICKET:${state.ticketId}|NAME:${state.fullName}|PHONE:${state.mobile}|STATUS:${state.paymentStatus}`;
          new QRCode(qrHolder, {
            text: qrData,
            width: 96,
            height: 96,
            colorDark: "#1B1030",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.M
          });
        }
      }
    } catch (renderError) {
      console.warn("Non-fatal ticket display error:", renderError);
    }
  }

  function printTicket(){ window.print(); }

  function downloadTicket(){
    const el = document.getElementById('nysm-ticket-render');
    if(typeof html2canvas === 'undefined'){ toast('Please wait for export module to load.'); return; }
    html2canvas(el, {backgroundColor:'#FFF8ED', scale:2}).then(canvas=>{
      const link = document.createElement('a');
      link.download = (state.ticketId || 'nysm-ticket') + '.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    });
  }

  function goToStep(step){
    if(step === 2 && !validateStep1()){
      toast('Please fill out all required fields with a valid age (4-40).');
      return;
    }
    if(step === 2){ renderEvents(); }
    if(step === 3){ renderSummary(); }
    showPanel(step);
  }

  function resetForm(){
    ['f-fullName','f-mobile','f-school','f-classCourse','f-age','f-teamSlot','f-reference','f-secretCode'].forEach(id=>{
      const el = document.getElementById(id);
      if(el) el.value = '';
    });
    document.querySelectorAll('.nysm-pill.selected').forEach(p=>p.classList.remove('selected'));
    document.getElementById('secret-msg').className = 'nysm-secret-msg';
    Object.assign(state, {
      fullName:"", mobile:"", school:"", classCourse:"", age:"",
      teamSlot:"", category:"", gender:"", reference:"",
      selectedEvents:{}, fee:0, secretCode:"", secretValid:false,
      ticketId:"", paymentStatus:"", orderId:""
    });
    showPanel(1);
  }

  window.NYSM = {
    goToStep, applySecretCode, startPayment, recheckStatus,
    confirmComplimentary, printTicket, downloadTicket, resetForm,
    setSubOption, setGroupCount, setTeamName
  };

})();
</script>

</body>
</html>